<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Native Android SplashScreen (cold start uniquement, typiquement < 200 ms).
        Fond noir + logo Junadé affiché en icône centrale.
        Sur API 31+, l'icône est clippée en cercle par le système — le Compose
        SplashScreen prend le relais immédiatement après pour le rendu brand complet.
    -->
    <style name="Theme.GainzNote.Launcher" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.GainzNote</item>
    </style>
    <style name="Theme.GainzNote" parent="Theme.AppCompat.Light.NoActionBar"/>
</resources>
